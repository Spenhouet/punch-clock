<?xml version="1.0" encoding="utf-8"?>
<!-- App mark, status dot and status text -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_mark" />

    <ImageView
        android:id="@+id/widget_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_dot_out" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/widget_not_clocked_in"
        android:textColor="@color/widget_on_surface"
        android:textSize="14sp" />
</LinearLayout>
